[gd_resource type="Resource" script_class="BossConfig" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/enemies/boss/boss_config.gd" id="1_script"]
[ext_resource type="Resource" path="res://resources/combat/presentation/fallen_matron.tres" id="2_profile"]
[ext_resource type="Script" path="res://scripts/enemies/boss/boss_phase_config.gd" id="3_phase"]

[sub_resource type="Resource" id="BossPhaseConfig_1"]
script = ExtResource("3_phase")
phase_id = &"corruption"
display_name = "Corruption"
hp_threshold_ratio = 0.66
attack_pattern_ids = ["corruption_bolt", "shadow_lash"]
skill_ids = ["matron_verdict"]
movement_profile = "bloom"
transition_message = "Corruption deepens."
presentation_profile = ExtResource("2_profile")
metadata = {}

[sub_resource type="Resource" id="BossPhaseConfig_2"]
script = ExtResource("3_phase")
phase_id = &"descent"
display_name = "Descent"
hp_threshold_ratio = 0.33
attack_pattern_ids = ["corruption_bolt", "shadow_lash", "soul_drain"]
skill_ids = ["matron_verdict"]
movement_profile = "bloom_descent"
transition_message = "The garden claims its due."
presentation_profile = ExtResource("2_profile")
metadata = {}

[resource]
script = ExtResource("1_script")
boss_id = "fallen_matron"
display_name = "The Fallen Matron"
phases = [SubResource("BossPhaseConfig_1"), SubResource("BossPhaseConfig_2")]
presentation_profile = ExtResource("2_profile")
health_display_enabled = true
transition_effects_enabled = true
metadata = {}